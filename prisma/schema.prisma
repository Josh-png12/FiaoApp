// =====================================================================
// FiaoApp — schema.prisma
// Multi-tenant por storeId (una DB, filtro por aplicación).
// Dinero: Decimal(12,2) en COP. Nunca Float.
// Movimientos (ventas, fiados, abonos) son APPEND-ONLY:
//   no se editan ni borran; se anulan con voidedAt + movimiento inverso.
// Sync offline: clientId (UUID generado en el dispositivo) es UNIQUE POR TIENDA
//   (storeId, clientId) → el endpoint /api/sync hace upsert por ese par (idempotente).
// Aislamiento multi-tienda a nivel de BD: los modelos referenciados tienen
//   @@unique([id, storeId]) y las relaciones son FK compuestas (xId, storeId),
//   de modo que Postgres impide relacionar filas de tiendas distintas.
//   Nunca se borra: todas las FK son onDelete: Restrict.
// Autoría (R2): Sale/Payment guardan createdByUserId y, al anular, voidedByUserId (FK compuestas).
//   El CHECK de autoría va NOT VALID: el histórico anterior a R2 puede tener NULL; las filas nuevas no.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// TENANCY Y USUARIOS
// ---------------------------------------------------------------------

model Store {
  id        String   @id @default(cuid())
  name      String
  ownerName String?
  // Código corto para que los empleados entren (R2). 6 caracteres del alfabeto
  // 23456789ABCDEFGHJKMNPQRSTVWXYZ (sin 0 O 1 I L U). CHECK de formato en la migración r2.
  code      String   @unique
  phone     String   @unique // teléfono principal de la tienda
  address   String?
  city      String   @default("Riohacha")
  plan      Plan     @default(FREE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  customers     Customer[]
  products      Product[]
  categories    Category[]
  sales         Sale[]
  payments      Payment[]
  stockEntries  StockEntry[]
  cashClosings  CashClosing[]
  suppliers     Supplier[]
  supplierDebts SupplierDebt[]
  saleItems     SaleItem[]
}

enum Plan {
  FREE
  TIENDA
  NEGOCIO
}

model User {
  id             String    @id @default(cuid())
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  name           String
  // Login OWNER: celular + PIN. Opcional en EMPLOYEE (que entra con código de tienda + usuario).
  // CHECK (migración r2): OWNER ⇒ phone no nulo. Único global entre quienes lo tengan.
  phone          String?   @unique
  // Login EMPLOYEE. Minúsculas [a-z0-9._], 3–20 (CHECK). Único por tienda. CHECK: EMPLOYEE ⇒ username.
  username       String?
  pinHash        String // bcrypt del PIN de 4-6 dígitos (R2 paso 3: sobre HMAC con pepper)
  pinHashVersion Int       @default(1) // 1 = bcrypt sin pepper; >= 2 = bcrypt sobre HMAC con pepper vN
  role           Role      @default(OWNER) // CHECK + índice parcial: exactamente un OWNER por tienda
  isActive       Boolean   @default(true)
  deactivatedAt  DateTime?
  tokenVersion   Int       @default(0) // sube para invalidar todas las sesiones del usuario
  mustChangePin  Boolean   @default(false)
  pinChangedAt   DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  salesCreated       Sale[]        @relation("SaleCreatedBy")
  salesVoided        Sale[]        @relation("SaleVoidedBy")
  paymentsCreated    Payment[]     @relation("PaymentCreatedBy")
  paymentsVoided     Payment[]     @relation("PaymentVoidedBy")
  stockEntriesVoided StockEntry[]  @relation("StockEntryVoidedBy")
  cashClosings       CashClosing[]

  @@unique([id, storeId])
  @@unique([storeId, username])
  @@index([storeId])
}

enum Role {
  OWNER // ve todo, edita precios, ve ganancias
  EMPLOYEE // solo registra ventas/fiados/abonos
}

// ---------------------------------------------------------------------
// CLIENTES Y FIADO
// ---------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  clientId    String? // UUID del dispositivo (sync); único por tienda
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  phone       String? // para recordatorio por WhatsApp
  photoUrl    String?
  note        String?
  creditLimit Decimal? @db.Decimal(12, 2) // límite sugerido (Fase 3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales    Sale[] // ventas fiadas asociadas
  payments Payment[] // abonos

  // saldo = SUM(ventas CREDIT no anuladas) - SUM(abonos no anulados)
  // Derivado, nunca fuente de verdad. Se puede cachear con un campo
  // balanceCache si el rendimiento lo pide, recalculable siempre.

  @@unique([id, storeId])
  @@unique([storeId, clientId])
  @@index([storeId, isActive])
  @@index([storeId, name])
}

// Abono a la deuda del cliente (contra el saldo, no contra una venta puntual,
// igual que en el cuaderno real).
model Payment {
  id              String    @id @default(cuid())
  clientId        String? // UUID del dispositivo (sync); único por tienda
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  customerId      String
  customer        Customer  @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  // Quién lo registró. Nullable solo por el histórico anterior a R2: CHECK NOT VALID exige autor en filas nuevas.
  createdByUserId String?
  createdBy       User?     @relation("PaymentCreatedBy", fields: [createdByUserId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  amount          Decimal   @db.Decimal(12, 2) // CHECK amount > 0 (migración r1)
  method          PayMethod @default(CASH)
  note            String?
  paidAt          DateTime  @default(now()) // fecha real (puede venir del cliente offline)
  voidedAt        DateTime? // anulación append-only
  // Quién anuló. CHECK (NOT VALID): voidedAt y voidedByUserId van juntos.
  voidedByUserId  String?
  voidedBy        User?     @relation("PaymentVoidedBy", fields: [voidedByUserId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  createdAt       DateTime  @default(now())

  @@unique([storeId, clientId])
  @@index([storeId, customerId])
  @@index([storeId, paidAt])
}

enum PayMethod {
  CASH
  NEQUI
  DAVIPLATA
  TRANSFER
  OTHER
}

// ---------------------------------------------------------------------
// PRODUCTOS E INVENTARIO (Fase 2)
// ---------------------------------------------------------------------

model Category {
  id               String    @id @default(cuid())
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id])
  name             String // "Abarrotes", "Bebidas", "Aseo"...
  defaultMarginPct Decimal?  @db.Decimal(5, 2) // fallback cuando no se conoce el costo
  products         Product[]

  @@unique([id, storeId])
  @@unique([storeId, name])
}

model Product {
  id         String    @id @default(cuid())
  clientId   String? // único por tienda
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  name       String
  photoUrl   String?
  salePrice  Decimal   @db.Decimal(12, 2)
  unitCost   Decimal?  @db.Decimal(12, 2) // costo actual (última entrada); null = usar margen de categoría
  stock      Decimal   @default(0) @db.Decimal(12, 3) // Decimal: permite vender por libras/fracciones
  minStock   Decimal?  @db.Decimal(12, 3) // alerta de reposición manual
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  saleItems    SaleItem[]
  stockEntries StockEntry[]

  @@unique([id, storeId])
  @@unique([storeId, clientId])
  @@index([storeId, isActive])
  @@index([storeId, name])
}

// Entrada de mercancía por lote: costo total + cantidad → costo unitario.
model StockEntry {
  id             String    @id @default(cuid())
  clientId       String? // único por tienda
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  quantity       Decimal   @db.Decimal(12, 3)
  totalCost      Decimal   @db.Decimal(12, 2)
  unitCost       Decimal   @db.Decimal(12, 4) // totalCost / quantity, calculado al crear
  enteredAt      DateTime  @default(now())
  voidedAt       DateTime?
  voidedByUserId String?
  voidedBy       User?     @relation("StockEntryVoidedBy", fields: [voidedByUserId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  createdAt      DateTime  @default(now())

  @@unique([storeId, clientId])
  @@index([storeId, productId])
}

// ---------------------------------------------------------------------
// VENTAS
// ---------------------------------------------------------------------

model Sale {
  id              String      @id @default(cuid())
  clientId        String? // UUID del dispositivo (sync idempotente); único por tienda
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id])
  // Quién la registró. Nullable solo por el histórico anterior a R2: CHECK NOT VALID exige autor en filas nuevas.
  createdByUserId String?
  createdBy       User?       @relation("SaleCreatedBy", fields: [createdByUserId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  customerId      String? // obligatorio si paymentType = CREDIT (CHECK en migración r1)
  customer        Customer?   @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  paymentType     PaymentType
  // total y costo se guardan desnormalizados para reportes rápidos,
  // pero siempre reconstruibles desde items (o venta libre sin items).
  total           Decimal     @db.Decimal(12, 2) // CHECK total > 0 (migración r1)
  totalCost       Decimal?    @db.Decimal(12, 2) // null en venta libre sin producto (MVP)
  note            String?
  soldAt          DateTime    @default(now()) // timestamp real, puede venir de offline
  voidedAt        DateTime?
  // Quién anuló. CHECK (NOT VALID): voidedAt y voidedByUserId van juntos.
  voidedByUserId  String?
  voidedBy        User?       @relation("SaleVoidedBy", fields: [voidedByUserId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  createdAt       DateTime    @default(now())

  items SaleItem[]

  @@unique([id, storeId])
  @@unique([storeId, clientId])
  @@index([storeId, soldAt])
  @@index([storeId, customerId])
  @@index([storeId, paymentType, soldAt])
}

enum PaymentType {
  CASH // efectivo
  CREDIT // fiado
  NEQUI
  DAVIPLATA
}

model SaleItem {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  saleId    String
  sale      Sale     @relation(fields: [saleId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  productId String
  product   Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  quantity  Decimal  @db.Decimal(12, 3) // CHECK quantity > 0 (migración r1)
  unitPrice Decimal  @db.Decimal(12, 2) // precio CONGELADO al vender
  unitCost  Decimal? @db.Decimal(12, 4) // costo CONGELADO al vender (clave para ganancia histórica)

  @@index([storeId, saleId])
  @@index([productId])
}

// ---------------------------------------------------------------------
// CIERRE DE CAJA (Fase 2)
// ---------------------------------------------------------------------

model CashClosing {
  id           String   @id @default(cuid())
  clientId     String? // único por tienda
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  date         DateTime @db.Date
  expectedCash Decimal  @db.Decimal(12, 2) // calculado: ventas CASH + abonos CASH del día
  countedCash  Decimal  @db.Decimal(12, 2) // lo que el tendero contó
  difference   Decimal  @db.Decimal(12, 2) // counted - expected
  note         String?
  createdAt    DateTime @default(now())

  @@unique([storeId, clientId])
  @@unique([storeId, date, userId]) // un cierre por usuario por día
  @@index([storeId, date])
}

// ---------------------------------------------------------------------
// PROVEEDORES Y CUENTAS POR PAGAR (Fase 3)
// ---------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockEntries StockEntry[]
  debts        SupplierDebt[]

  @@unique([id, storeId])
  @@index([storeId])
}

model SupplierDebt {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  amount     Decimal   @db.Decimal(12, 2)
  dueDate    DateTime? @db.Date
  paidAt     DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([storeId, dueDate])
}

// ---------------------------------------------------------------------
// AUTENTICACIÓN (R2, ver docs/R2-AUTENTICACION.md)
// ---------------------------------------------------------------------

// Contadores de intentos fallidos y bloqueos temporales (sin Redis). Una fila por clave:
// "acctip:<h(cuenta)>:<h(ip)>", "acct:<h(cuenta)>", "ip:<h(ip)>:login", "ip:<h(ip)>:register".
// Las claves llevan HMAC, nunca el celular, usuario ni IP en claro. Se limpia a las 24-48 h.
model RateLimit {
  key         String    @id
  fails       Int       @default(0)
  strikes     Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([updatedAt])
}

// Bitácora de eventos de autenticación. Solo INSERT desde la app; nunca guarda PIN, tokens ni cookies.
// storeId/userId son referencias lógicas (sin FK): un login fallido no tiene usuario, y la bitácora
// no debe impedir ni verse afectada por cambios en User/Store. Retención 180 días.
model AuthEvent {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  type      AuthEventType
  ok        Boolean
  storeId   String?
  userId    String?
  ipHash    String? // HMAC con IP_HASH_KEY, nunca la IP en claro
  userAgent String? // recortado
  meta      Json? // solo datos no sensibles

  @@index([storeId, createdAt])
  @@index([userId, type, createdAt])
  @@index([createdAt])
}

enum AuthEventType {
  LOGIN_OK
  LOGIN_FAIL
  LOGIN_LOCKED
  LOGOUT
  PIN_CHANGED
  PIN_RESET_BY_OWNER
  SESSIONS_REVOKED
  EMPLOYEE_CREATED
  EMPLOYEE_DEACTIVATED
  EMPLOYEE_REACTIVATED
  STORE_REGISTERED
}
